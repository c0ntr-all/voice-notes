# Ключ сервисного аккаунта Yandex Cloud. В запрос уходит как Authorization: Api-Key.
# Достаточно одного из двух способов: API-ключ или IAM-токен.
QCLI_YANDEX_SPEECHKIT_API_KEY=

# IAM-токен. Используется, только если API-ключ пуст. Authorization: Bearer.
QCLI_YANDEX_IAM_TOKEN=

# Каталог Yandex Cloud. Нужен для большинства ключей SpeechKit.
QCLI_YANDEX_FOLDER_ID=

# Куда приложение отправляет уже распознанный текст.
# Тело: { client_uuid, body, recorded_at, duration_ms }
QCLI_NOTES_API_URL=http://localhost:8080/api/notes
